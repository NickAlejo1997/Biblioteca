<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'Biblioteca'}" /> | Biblioteca</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');
        body { font-family: 'DM Sans', sans-serif; }
        .font-display { font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="flex min-h-screen flex-col bg-[#f8f9fc] text-slate-800">
<nav class="border-b border-slate-200/80 bg-white/95 backdrop-blur">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <a href="${pageContext.request.contextPath}/app/inicio" class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-indigo-600 text-xl font-bold text-white shadow-sm shadow-indigo-200">B</span>
            <span class="font-display text-[1.35rem] font-bold text-slate-950">Biblioteca</span>
        </a>
        <div class="flex w-full items-center justify-end gap-1 text-sm font-semibold sm:w-auto sm:gap-2">
            <a href="${pageContext.request.contextPath}/app/libros" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-indigo-50 hover:text-indigo-700 sm:px-4">Libros</a>
            <a href="${pageContext.request.contextPath}/app/prestamos" class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-indigo-50 hover:text-indigo-700 sm:px-4">Préstamos</a>
            <a href="${pageContext.request.contextPath}/app/prestamos/nuevo" class="rounded-lg bg-indigo-600 px-3 py-2 text-white shadow-sm shadow-indigo-200 transition hover:bg-indigo-700 sm:px-4">Nuevo préstamo</a>
        </div>
    </div>
</nav>
<main class="mx-auto w-full max-w-6xl flex-1 px-5 py-8 sm:px-8 sm:py-12">
